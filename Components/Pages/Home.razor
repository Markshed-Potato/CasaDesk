@page "/"
@inject HelpdeskState State

<PageTitle>CasaDesk | Resident Dashboard</PageTitle>
<PageHeader Section="Resident Dashboard" Title="@DashboardGreeting" Subtitle="Follow each report as it moves through the pipeline." ActionText="+ New Report" ActionHref="/report/new" />

<div class="space-y-5">
    <section class="grid gap-4">
        @foreach (var report in State.Reports.Take(2))
        {
            <article class="rounded-lg border border-[#e2e5df] bg-white p-4 shadow-sm sm:p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div><h2 class="font-semibold">@report.Title</h2><p class="mt-1 text-xs text-[#77878d]">@report.Location <span class="px-1">·</span> @report.Category <span class="px-1">·</span> Submitted @report.Submitted</p></div>
                    <span class="rounded-full px-2.5 py-1 text-[11px] font-semibold @StatusClass(report.Status)">@report.Status</span>
                </div>
                <div class="mt-4"><ReportProgress Report="report" /></div>
                <div class="mt-4 flex flex-wrap items-center justify-between gap-3"><p class="text-xs text-[#718187]">@report.Summary</p><a class="rounded-md border border-[#216f7d] px-3 py-2 text-xs font-semibold text-[#216f7d] hover:bg-[#e5efed]" href="/reports/@report.Id">Track Report</a></div>
            </article>
        }
    </section>
    <section class="rounded-lg border border-[#e2e5df] bg-white p-4 shadow-sm sm:p-5">
        <div class="mb-4 flex items-center justify-between"><h2 class="font-semibold">Recent Activity</h2><span class="text-xs text-[#819096]">Latest updates</span></div>
        <div class="divide-y divide-[#edf0eb]">
            @foreach (var item in State.Activity.Take(5))
            {
                <a class="flex items-start gap-3 py-3 first:pt-0 last:pb-0" href="/reports/@item.ReportId"><span class="mt-1.5 size-2 shrink-0 rounded-full @(item.IsGold ? "bg-[#dfae2f]" : "bg-[#216f7d]")"></span><span class="min-w-0 flex-1"><strong class="block text-sm">@item.Title</strong><span class="mt-0.5 block text-xs text-[#77878d]">@item.Detail</span></span><span class="shrink-0 text-xs text-[#819096]">@item.Date</span></a>
            }
        </div>
    </section>
</div>

@code {
    private string DashboardGreeting => $"Good morning, {State.ProfileName.Split(' ')[0]}";

    protected override void OnInitialized() => State.SetAdmin(false);

    private static string StatusClass(string status) => status switch
    {
        "Received" or "Assigned" => "bg-[#e4f1f2] text-[#216f7d]",
        "In Progress" => "bg-[#fbf1d4] text-[#8d6b13]",
        "Resolved" => "bg-[#e7efe4] text-[#4f754f]",
        _ => "bg-[#edf0eb] text-[#5f6e72]"
    };
}