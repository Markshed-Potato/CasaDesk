@inherits LayoutComponentBase
@implements IDisposable
@inject HelpdeskState State
@inject NavigationManager Navigation

<div class="min-h-screen bg-[#f5f4ef] text-[#203137]">
    <SideNav />
    <main class="min-w-0 px-4 py-6 sm:px-7 lg:px-10 lg:py-8 md:ml-60">
        <div class="mx-auto max-w-6xl">@Body</div>
    </main>
</div>

@if (!string.IsNullOrWhiteSpace(State.Toast))
{
    <div class="fixed bottom-4 right-4 z-50 flex max-w-sm items-center gap-4 rounded-md bg-[#203137] px-4 py-3 text-sm text-white shadow-lg" role="status">
        <span>@State.Toast</span>
        <button class="text-lg leading-none text-white/70 hover:text-white" aria-label="Dismiss notification" @onclick="State.ClearToast">×</button>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized() => State.StateChanged += OnStateChanged;

    protected override void OnParametersSet()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        if (!State.IsAuthenticated && path is not ("login" or "register"))
        {
            Navigation.NavigateTo("/login", replace: true);
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => State.StateChanged -= OnStateChanged;
}

