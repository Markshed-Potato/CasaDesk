@inject HelpdeskState State
@inject NavigationManager Navigation

<aside class="app-sidebar flex w-full shrink-0 flex-col bg-[#216f7d] text-white md:fixed md:inset-y-0 md:left-0 md:h-screen md:w-60 md:overflow-y-auto">
    <div class="flex items-center gap-3 px-4 py-4 md:px-5 md:pt-6">
        <span class="grid size-8 place-items-center rounded-md bg-[#dfae2f] font-black text-[#174c57]">C</span>
        <span class="font-semibold">CasaDesk</span>
        @if (State.IsAdmin) { <span class="ml-auto rounded-full bg-[#dfae2f] px-2 py-1 text-[10px] font-bold uppercase text-[#174c57]">Admin</span> }
    </div>
    <nav class="flex gap-1 overflow-x-auto px-3 pb-3 md:flex-1 md:flex-col md:py-7" aria-label="Main navigation">
        @if (State.IsAdmin)
        {
            <NavLink href="/admin" Match="NavLinkMatch.All" class="shrink-0 rounded-md px-3 py-2.5 text-xs font-medium text-white/90 hover:bg-white/10 hover:text-white md:w-full" ActiveClass="bg-[#dfae2f] !text-[#203137]">Report Pipeline</NavLink>
            <NavLink href="/admin/reports/1042" class="shrink-0 rounded-md px-3 py-2.5 text-xs font-medium text-white/90 hover:bg-white/10 hover:text-white md:w-full" ActiveClass="bg-[#dfae2f] !text-[#203137]">Report Detail</NavLink>
        }
        else
        {
            <NavLink href="/" Match="NavLinkMatch.All" class="shrink-0 rounded-md px-3 py-2.5 text-xs font-medium text-white/90 hover:bg-white/10 hover:text-white md:w-full" ActiveClass="bg-[#dfae2f] !text-[#203137]">My Reports</NavLink>
            <NavLink href="/report/new" class="shrink-0 rounded-md px-3 py-2.5 text-xs font-medium text-white/90 hover:bg-white/10 hover:text-white md:w-full" ActiveClass="bg-[#dfae2f] !text-[#203137]">Report an Issue</NavLink>
            <NavLink href="/profile" class="shrink-0 rounded-md px-3 py-2.5 text-xs font-medium text-white/90 hover:bg-white/10 hover:text-white md:w-full" ActiveClass="bg-[#dfae2f] !text-[#203137]">My Profile</NavLink>
        }
    </nav>
    <div class="mt-auto hidden space-y-2.5 px-4 pb-5 md:block">
        <button class="w-full rounded-md border border-white/50 px-3 py-2.5 text-sm font-medium hover:bg-white/10" @onclick="ToggleRole">Switch to @(State.IsAdmin ? "Resident" : "Admin") View</button>
        <div class="flex items-start gap-3 rounded-md border border-white/50 px-3 py-3 text-white">
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-[#dfae2f] text-sm font-semibold text-white">@State.Initials</span>
            <span class="min-w-0 flex-1">
                <strong class="block break-words text-sm font-semibold leading-5 capitalize">@State.ProfileName</strong>
                <span class="mt-0.5 block break-words text-xs leading-4 text-white/75">@(State.IsAdmin ? "HOA Administrator" : State.ProfileAddress)</span>
            </span>
        </div>
        <button class="w-full rounded-md border border-white/35 px-3 py-2.5 text-left text-sm font-medium text-white/90 transition hover:bg-white/10 hover:text-white" @onclick="SignOut">Sign out</button>
    </div>
    <div class="flex items-center justify-between gap-3 px-4 pb-3 md:hidden">
        <button class="rounded-md border border-white/50 px-3 py-2.5 text-sm font-medium" @onclick="ToggleRole">Switch to @(State.IsAdmin ? "Resident" : "Admin") View</button>
        <button class="rounded-md border border-white/35 px-3 py-2.5 text-sm font-medium text-white/90 hover:bg-white/10" @onclick="SignOut">Sign out</button>
    </div>
</aside>

@code {
    private void ToggleRole()
    {
        State.SetAdmin(!State.IsAdmin);
        Navigation.NavigateTo(State.IsAdmin ? "/admin" : "/");
    }

    private void SignOut()
    {
        State.SignOut();
        Navigation.NavigateTo("/login");
    }
}