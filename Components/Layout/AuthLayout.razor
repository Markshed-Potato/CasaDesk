@inherits LayoutComponentBase

<div class="min-h-screen bg-[#f5f4ef] text-[#203137] lg:grid lg:grid-cols-[minmax(360px,0.95fr)_minmax(0,1.05fr)]">
	<aside class="app-sidebar flex flex-col justify-between bg-[#216f7d] px-5 py-5 text-white sm:px-8 sm:py-7 lg:min-h-screen lg:px-12 lg:py-11">
		<a href="/login" class="inline-flex w-fit items-center gap-3">
			<span class="grid size-10 place-items-center rounded-md bg-[#dfae2f] font-black text-[#174c57]">C</span>
			<span class="text-lg font-semibold">CasaDesk</span>
		</a>
		<div class="mt-7 max-w-lg lg:mt-0">
			<p class="text-xs font-bold uppercase tracking-[0.14em] text-[#f3d579]">Resident Portal</p>
			<h2 class="mt-3 max-w-md text-2xl font-bold leading-tight sm:text-3xl lg:text-4xl">Community reports, with a clear path forward.</h2>
			<p class="mt-3 max-w-md text-sm leading-6 text-white/80">Report a neighborhood issue, follow the work, and stay in touch with your community team.</p>
			<div class="mt-6 grid max-w-md grid-cols-3 gap-3" aria-label="Report stages">
				<span><span class="mb-2 block h-1 rounded-full bg-[#dfae2f]"></span><span class="text-[11px] font-semibold">Received</span></span>
				<span><span class="mb-2 block h-1 rounded-full bg-white/50"></span><span class="text-[11px] font-semibold">In progress</span></span>
				<span><span class="mb-2 block h-1 rounded-full bg-white/25"></span><span class="text-[11px] font-semibold">Resolved</span></span>
			</div>
		</div>
		<p class="mt-6 hidden text-xs text-white/65 lg:block">CasaDesk <span class="px-1">·</span> Resident services</p>
	</aside>
	<main class="grid min-w-0 place-items-center px-4 py-7 sm:px-8 sm:py-10 lg:px-12">
		<div class="w-full max-w-lg">@Body</div>
	</main>
</div>